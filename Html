      <button id="nextBtn" title="Next surah" aria-label="Next surah">
        <svg viewBox="0 0 24 24"><path d="M16 6h2v12h-2zM6 6v12l8.5-6z"/></svg>
      </button>
    </div>
    <div class="p-seek">
      <span id="curTime">0:00</span>
      <input type="range" id="seek" min="0" max="100" value="0">
      <span id="durTime">0:00</span>
    </div>
    <div class="p-vol">
      <svg viewBox="0 0 24 24"><path d="M3 10v4h4l5 5V5L7 10H3zm13.5 2a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4z"/></svg>
      <input type="range" id="volume" min="0" max="1" step="0.01" value="1">
    </div>
    <div class="p-status" id="pStatus">Ready</div>
  </div>
</div>

