  </div>
</section>

<div class="divider"><div class="line"></div><div class="diamond"></div><div class="line"></div></div>

<footer>
  <span class="fname">Aicha Abdellah</span>
  An ongoing charity for the sake of Allah
</footer>

<audio id="audio" preload="none"></audio>

<div class="player">
  <div class="wrap">
    <div class="p-badge" id="pBadge">
      <svg viewBox="0 0 24 24"><path d="M12 2 15 8 22 9 17 14 18 21 12 17.5 6 21 7 14 2 9 9 8Z"/></svg>
    </div>
    <div class="p-info">
      <div class="surah" id="pSurahName">Al-Fatihah</div>
      <div class="reciter" id="pReciterName">—</div>
