    [47,"Muhammad","Muhammad",38,"Medinan"],[48,"Al-Fath","The Victory",29,"Medinan"],
    [49,"Al-Hujurat","The Rooms",18,"Medinan"],[50,"Qaf","Qaf",45,"Meccan"],
    [51,"Adh-Dhariyat","The Winnowing Winds",60,"Meccan"],[52,"At-Tur","The Mount",49,"Meccan"],
    [53,"An-Najm","The Star",62,"Meccan"],[54,"Al-Qamar","The Moon",55,"Meccan"],
    [55,"Ar-Rahman","The Beneficent",78,"Medinan"],[56,"Al-Waqi'ah","The Inevitable",96,"Meccan"],
    [57,"Al-Hadid","The Iron",29,"Medinan"],[58,"Al-Mujadila","The Pleading Woman",22,"Medinan"],
    [59,"Al-Hashr","The Exile",24,"Medinan"],[60,"Al-Mumtahanah","She That Is To Be Examined",13,"Medinan"],
    [61,"As-Saff","The Ranks",14,"Medinan"],[62,"Al-Jumu'ah","Friday",11,"Medinan"],
    [63,"Al-Munafiqun","The Hypocrites",11,"Medinan"],[64,"At-Taghabun","Mutual Disillusion",18,"Medinan"],
    [65,"At-Talaq","Divorce",12,"Medinan"],[66,"At-Tahrim","The Prohibition",12,"Medinan"],
    [67,"Al-Mulk","Sovereignty",30,"Meccan"],[68,"Al-Qalam","The Pen",52,"Meccan"],
    [69,"Al-Haqqah","The Reality",52,"Meccan"],[70,"Al-Ma'arij","The Ascending Stairways",44,"Meccan"],
    [71,"Nuh","Noah",28,"Meccan"],[72,"Al-Jinn","The Jinn",28,"Meccan"],
    [73,"Al-Muzzammil","The Enshrouded One",20,"Meccan"],[74,"Al-Muddaththir","The Cloaked One",56,"Meccan"],
    [75,"Al-Qiyamah","The Resurrection",40,"Meccan"],[76,"Al-Insan","Man",31,"Medinan"],
    [77,"Al-Mursalat","The Emissaries",50,"Meccan"],[78,"An-Naba","The Tidings",40,"Meccan"],
    [79,"An-Nazi'at","Those Who Drag Forth",46,"Meccan"],[80,"Abasa","He Frowned",42,"Meccan"],
    [81,"At-Takwir","The Overthrowing",29,"Meccan"],[82,"Al-Infitar","The Cleaving",19,"Meccan"],
    [83,"Al-Mutaffifin","Defrauding",36,"Meccan"],[84,"Al-Inshiqaq","The Sundering",25,"Meccan"],
    [85,"Al-Buruj","The Mansions of the Stars",22,"Meccan"],[86,"At-Tariq","The Nightcomer",17,"Meccan"],
    [87,"Al-A'la","The Most High",19,"Meccan"],[88,"Al-Ghashiyah","The Overwhelming",26,"Meccan"],
    [89,"Al-Fajr","The Dawn",30,"Meccan"],[90,"Al-Balad","The City",20,"Meccan"],
    [91,"Ash-Shams","The Sun",15,"Meccan"],[92,"Al-Layl","The Night",21,"Meccan"],
    [93,"Ad-Duhaa","The Morning Hours",11,"Meccan"],[94,"Ash-Sharh","The Relief",8,"Meccan"],
    [95,"At-Tin","The Fig",8,"Meccan"],[96,"Al-Alaq","The Clot",19,"Meccan"],
    [97,"Al-Qadr","The Power",5,"Meccan"],[98,"Al-Bayyinah","The Clear Proof",8,"Medinan"],
    [99,"Az-Zalzalah","The Earthquake",8,"Medinan"],[100,"Al-Adiyat","The Courser",11,"Meccan"],
    [101,"Al-Qari'ah","The Calamity",11,"Meccan"],[102,"At-Takathur","Rivalry in World Increase",8,"Meccan"],
    [103,"Al-Asr","The Declining Day",3,"Meccan"],[104,"Al-Humazah","The Traducer",9,"Meccan"],
    [105,"Al-Fil","The Elephant",5,"Meccan"],[106,"Quraysh","Quraysh",4,"Meccan"],
    [107,"Al-Ma'un","Small Kindnesses",7,"Meccan"],[108,"Al-Kawthar","Abundance",3,"Meccan"],
    [109,"Al-Kafirun","The Disbelievers",6,"Meccan"],[110,"An-Nasr","Divine Support",3,"Medinan"],
    [111,"Al-Masad","The Palm Fiber",5,"Meccan"],[112,"Al-Ikhlas","Sincerity",4,"Meccan"],
    [113,"Al-Falaq","The Daybreak",5,"Meccan"],[114,"An-Nas","Mankind",6,"Meccan"]
  ].map(s => ({ number:s[0], name:s[1], meaning:s[2], ayahs:s[3], type:s[4] }));

  const AYAT = [
    ["وَنُنَزِّلُ مِنَ الْقُرْآنِ مَا هُوَ شِفَاءٌ وَرَحْمَةٌ لِلْمُؤْمِنِينَ","We send down of the Quran that which is healing and mercy for the believers.","Surah Al-Isra, 17:82"],
    ["إِنَّ مَعَ الْعُسْرِ يُسْرًا","Indeed, with hardship comes ease.","Surah Ash-Sharh, 94:6"],
    ["وَمَن يَتَّقِ اللَّهَ يَجْعَل لَّهُ مَخْرَجًا","Whoever is mindful of Allah, He will make a way out for them.","Surah At-Talaq, 65:2"],
    ["أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ","Verily, in the remembrance of Allah do hearts find rest.","Surah Ar-Ra'd, 13:28"],
    ["إِنَّ اللَّهَ مَعَ الصَّابِرِينَ","Indeed, Allah is with the patient.","Surah Al-Baqarah, 2:153"],
    ["وَبَشِّرِ الصَّابِرِينَ","And give good tidings to the patient.","Surah Al-Baqarah, 2:155"]
  ];

  /* ---------- Helpers ---------- */
  const $ = sel => document.querySelector(sel);
  const audio = $("#audio");
  const BITRATES = [128, 64, 32];

  function buildUrl(reciterId, surahNumber, bitrateIdx){
    const bitrate = BITRATES[bitrateIdx] || 128;
    return `https://cdn.islamic.network/quran/audio-surah/${bitrate}/${reciterId}/${surahNumber}.mp3`;
  }

  function fmtTime(t){
    if(!isFinite(t) || t < 0) t = 0;
    const m = Math.floor(t/60), s = Math.floor(t%60);
    return `${m}:${String(s).padStart(2,"0")}`;
  }

  /* ---------- State ---------- */
  let state = { reciterIdx: 0, surahNumber: 1, bitrateIdx: 0, isPlaying:false };
  try{
    const saved = JSON.parse(localStorage.getItem("aicha-quran-state") || "null");
    if(saved && typeof saved.reciterIdx === "number" && typeof saved.surahNumber === "number"){
      state.reciterIdx = Math.min(Math.max(saved.reciterIdx,0), RECITERS.length-1);
      state.surahNumber = Math.min(Math.max(saved.surahNumber,1), 114);
    }
  }catch(e){}

  function persist(){
    try{ localStorage.setItem("aicha-quran-state", JSON.stringify({reciterIdx:state.reciterIdx, surahNumber:state.surahNumber})); }catch(e){}
  }

  /* ---------- Render reciters ---------- */
  const recitersGrid = $("#recitersGrid");
  $("#reciterCount").textContent = RECITERS.length + " reciters";
  const micSvg = '<svg viewBox="0 0 24 24"><path d="M12 14a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v5a3 3 0 0 0 3 3zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.92V21h2v-3.08A7 7 0 0 0 19 11h-2z"/></svg>';
  RECITERS.forEach((r, idx) => {
    const card = document.createElement("div");
    card.className = "reciter-card" + (idx === state.reciterIdx ? " active" : "");
    card.dataset.idx = idx;
    card.innerHTML = `<span class="badge">${micSvg}</span><span><span class="name">${r.name}</span><span class="tag">Reciter</span></span>`;
    card.addEventListener("click", () => selectReciter(idx, true));
    recitersGrid.appendChild(card);
  });

  /* ---------- Render surahs ---------- */
  const surahList = $("#surahList");
  function renderSurahs(filter){
    surahList.innerHTML = "";
    const f = (filter||"").trim().toLowerCase();
    const list = SURAHS.filter(s => !f || s.name.toLowerCase().includes(f) || s.meaning.toLowerCase().includes(f) || String(s.number).includes(f));
    if(list.length === 0){
      surahList.innerHTML = '<div class="no-results">No matching surah found</div>';
      return;
    }
    list.forEach(s => {
      const row = document.createElement("div");
      row.className = "surah-row" + (s.number === state.surahNumber ? " active" : "");
      row.dataset.num = s.number;
      row.innerHTML = `<span class="num">${s.number}</span>
        <span class="meta"><span class="aname">${s.name}</span><span class="info">${s.ayahs} verses · ${s.type}</span></span>`;
      row.addEventListener("click", () => selectSurah(s.number, true));
      surahList.appendChild(row);
    });
  }
  renderSurahs("");
  $("#surahSearch").addEventListener("input", e => renderSurahs(e.target.value));

  /* ---------- Player wiring ---------- */
  const playBtn = $("#playBtn"), playIcon = $("#playIcon"), heroPlayIcon = $("#heroPlayIcon");
  const pBadge = $("#pBadge"), shamsaWrap = $("#shamsaBtn");
  const pSurahName = $("#pSurahName"), pReciterName = $("#pReciterName"), pStatus = $("#pStatus");
  const seek = $("#seek"), curTime = $("#curTime"), durTime = $("#durTime"), volume = $("#volume");

  const ICON_PLAY = '<path d="M8 5v14l11-7z"/>';
  const ICON_PAUSE = '<path d="M7 5h4v14H7zM13 5h4v14h-4z"/>';

  function currentSurah(){ return SURAHS.find(s => s.number === state.surahNumber) || SURAHS[0]; }

  function updateInfoUI(){
    const s = currentSurah();
    pSurahName.textContent = s.name;
    pReciterName.textContent = RECITERS[state.reciterIdx].name;
    document.title = `${s.name} — ${RECITERS[state.reciterIdx].name} | Aicha Abdellah`;
    document.querySelectorAll(".reciter-card").forEach(c => c.classList.toggle("active", +c.dataset.idx === state.reciterIdx));
    document.querySelectorAll(".surah-row").forEach(r => r.classList.toggle("active", +r.dataset.num === state.surahNumber));
  }

  function loadCurrent(autoplay){
    state.bitrateIdx = 0;
    pStatus.textContent = "Loading…";
    audio.src = buildUrl(RECITERS[state.reciterIdx].id, state.surahNumber, state.bitrateIdx);
    audio.load();
    updateInfoUI();
    persist();
    if(autoplay){ attemptPlay(); }
  }

  function attemptPlay(){
    const p = audio.play();
    if(p && p.catch){ p.catch(()=>{ /* blocked until user interacts */ }); }
  }

  function selectReciter(idx, autoplay){
    state.reciterIdx = idx;
    loadCurrent(autoplay || state.isPlaying);
  }
  function selectSurah(num, autoplay){
    state.surahNumber = num;
    loadCurrent(autoplay || state.isPlaying);
  }
  function stepSurah(delta){
    let n = state.surahNumber + delta;
    if(n < 1) n = 114;
    if(n > 114) n = 1;
    selectSurah(n, true);
  }

  audio.addEventListener("play", () => {
    state.isPlaying = true;
    playIcon.innerHTML = ICON_PAUSE;
    heroPlayIcon.querySelector("svg").innerHTML = ICON_PAUSE;
    pBadge.classList.add("spin");
    shamsaWrap.classList.add("spin");
    pStatus.textContent = "Now playing";
  });
  audio.addEventListener("pause", () => {
    state.isPlaying = false;
    playIcon.innerHTML = ICON_PLAY;
    heroPlayIcon.querySelector("svg").innerHTML = ICON_PLAY;
    pBadge.classList.remove("spin");
    shamsaWrap.classList.remove("spin");
    pStatus.textContent = "Paused";
  });
  audio.addEventListener("timeupdate", () => {
    if(!isFinite(audio.duration)) return;
    seek.value = (audio.currentTime / audio.duration) * 100 || 0;
    curTime.textContent = fmtTime(audio.currentTime);
    durTime.textContent = fmtTime(audio.duration);
  });
  audio.addEventListener("ended", () => stepSurah(1));
  audio.addEventListener("error", () => {
    if(state.bitrateIdx < BITRATES.length - 1){
      state.bitrateIdx++;
      audio.src = buildUrl(RECITERS[state.reciterIdx].id, state.surahNumber, state.bitrateIdx);
      audio.load();
      attemptPlay();
    } else {
      pStatus.textContent = "Couldn't load — try another reciter";
    }
  });

  playBtn.addEventListener("click", () => { audio.paused ? attemptPlay() : audio.pause(); });
  shamsaWrap.addEventListener("click", () => { audio.paused ? attemptPlay() : audio.pause(); });
  $("#prevBtn").addEventListener("click", () => stepSurah(-1));
  $("#nextBtn").addEventListener("click", () => stepSurah(1));
  seek.addEventListener("input", () => {
    if(isFinite(audio.duration)) audio.currentTime = (seek.value/100) * audio.duration;
  });
  volume.addEventListener("input", () => { audio.volume = +volume.value; audio.muted = false; });

  /* ---------- Ayah of the day ---------- */
  (function(){
    const idx = new Date().getDate() % AYAT.length;
    const el = $("#ayahOfDay");
    el.innerHTML = `${AYAT[idx][0]}<small>"${AYAT[idx][1]}"<br><span class="ref">${AYAT[idx][2]}</span></small>`;
  })();

  /* ---------- Near-instant playback: muted autoplay, unmute on first interaction ---------- */
  audio.volume = 1;
  audio.muted = true;
  loadCurrent(true);
  const hint = $("#unmuteHint");
  setTimeout(() => { if(audio.muted) hint.classList.add("show"); }, 900);
  function unmuteOnce(){
    audio.muted = false;
    hint.classList.remove("show");
    if(audio.paused) attemptPlay();
    ["click","touchstart","keydown","scroll"].forEach(ev => document.removeEventListener(ev, unmuteOnce));
  }
  ["click","touchstart","keydown","scroll"].forEach(ev => document.addEventListener(ev, unmuteOnce, {passive:true}));

})();
</script>
